# Copy to .env and adjust for your local Postgres.
DATABASE_URL="postgresql://fairsplit:localdev@localhost:5432/fairsplit?schema=public"

# Production only (see docs/DEPLOY.md): direct/session-mode connection used by
# `prisma migrate deploy`. Leave unset locally — DATABASE_URL is already direct.
# DIRECT_URL=""

# Auth.js — generate a real secret with: npx auth secret
AUTH_SECRET="dev-only-placeholder-change-me"
# Required when running `next start` outside a known host platform
# (trusts the Host header; keep true for local and reverse-proxy deploys).
AUTH_TRUST_HOST="true"
# Google OAuth (console.cloud.google.com); callback URL: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Rate provider base URL; empty = public Frankfurter. Point at a
# self-hosted Frankfurter (Docker) to swap providers with no code change.
FRANKFURTER_BASE_URL=""

# Gemini API key for receipt parsing (aistudio.google.com/apikey)
GEMINI_API_KEY=""
