# Copy to .env and adjust for your local Postgres.
DATABASE_URL="postgresql://fairsplit:localdev@localhost:5432/fairsplit?schema=public"

# Production only (see docs/DEPLOY.md): direct/session-mode connection used by
# `prisma migrate deploy`. Leave unset locally — DATABASE_URL is already direct.
# DIRECT_URL=""

# Auth.js — generate a real secret with: npx auth secret
AUTH_SECRET="dev-only-placeholder-change-me"
# Required when running `next start` outside a known host platform
# (trusts the Host header; keep true for local and reverse-proxy deploys).
AUTH_TRUST_HOST="true"
# Google OAuth (console.cloud.google.com); callback URL: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Rate provider base URL; empty = public Frankfurter. Point at a
# self-hosted Frankfurter (Docker) to swap providers with no code change.
FRANKFURTER_BASE_URL=""

# Gemini API key for receipt parsing (aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Chat fallback interpreter (DECISIONS D2-3). Empty = on in production,
# off everywhere else: development, test and e2e are rules-only, because a
# fallback that quietly produces a card hides the parser failures the
# corpus exists to measure. Set "true"/"1" to look at it locally, or
# "false"/"0" to force it off. Receipt SCANNING is unaffected — that path
# reads GEMINI_API_KEY above and is not gated here.
CHAT_FALLBACK_ENABLED=""

# Dev-mode allowlist (PLAN.md Stage 2). Comma- or whitespace-separated
# addresses that get the parser trace panel, the recall button and a
# lifted receipt-scan cap. Empty = nobody, which is the production default.
# An address here only counts on an account whose User.emailVerified is
# stamped (DECISIONS D2-17: an OAuth/OIDC sign-in stamps it) — signing up
# with someone's address over email/password grants nothing. See
# src/app/dev/role-policy.ts.
DEV_EMAILS=""

# e2e isolation (optional). Unset = today's defaults: port 3100 and the
# scratch database `<DATABASE_URL's db>_e2e`. Override BOTH when a second
# checkout of this repo must run `npm run test:e2e` at the same time as the
# first — the suite drops and recreates its database, so two concurrent runs
# on the same name kill each other. E2E_DB_NAME must end in `_e2e`
# (scripts/e2e-db-reset.sh refuses anything else).
# E2E_PORT=3101
# E2E_DB_NAME=fairsplit_w3_e2e
