{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // Scripts under scripts/**/*.mts run on Node's native type stripping
    // ("node scripts/corpus/recover-chat-logs.mts"), which does NOT rewrite
    // import specifiers — a relative import has to name the .mts file that
    // actually exists on disk. This flag lets tsc accept that specifier; it
    // is safe here because the project never emits (noEmit above).
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "patches", "patches3", "patches4", "patches5"]
}
