# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the env template
!.env.example

# reference recordings and screenshots dropped in the repo root for review —
# working material, not product source
/*.mp4
/*.mov
/KakaoTalk_*

# real receipt photos used to calibrate the parser. They carry a real person's
# purchases, timestamps, locations and partially-masked card numbers, so they
# stay out of git: never in a clone, a public artefact, or a Vercel build.
# Only the README explaining the folder is tracked.
/test-fixtures/receipts/*
!/test-fixtures/receipts/README.md

# Word's lock file, created whenever a .docx under docs/ is open for reading
~$*

# WSL/Windows alternate-data-stream droppings
*:Zone.Identifier

# playwright-cli session artifacts
.playwright-cli/
.exp/
.kiwi-model/
