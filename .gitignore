# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# assistant/harness artifacts — never commit

# keep the env template
!.env.example

# reference recordings and screenshots dropped in the repo root for review —
# working material, not product source
/*.mp4
/*.mov
/KakaoTalk_*

# Chat-log recovery working files. `chat-log-recovered.json` (the redacted
# one) IS tracked; these two are not:
#   *-review.local.json — rows whose redaction could not be proved complete
#   *-raw.local.json    — `--raw` output, real member names, local only
/test-fixtures/staging/*.local.json

# real receipt photos used to calibrate the parser. They carry a real person's
# purchases, timestamps, locations and partially-masked card numbers, so they
# stay out of git: never in a clone, a public artefact, or a Vercel build.
# Only the README explaining the folder is tracked.
/test-fixtures/receipts/*
!/test-fixtures/receipts/README.md

# Word's lock file, created whenever a .docx under docs/ is open for reading
~$*

# WSL/Windows alternate-data-stream droppings
*:Zone.Identifier

# playwright-cli session artifacts
.playwright-cli/
.exp/
.kiwi-model/

# Owner-supplied working material dropped in the repo root (design feedback
# packets, reference video frames). Not product content and not reviewed, so
# it must never enter a commit — a `git add -A` in the post-rulings patch
# session swept these in once and the commits had to be rebuilt to get them
# back out (docs/status/PATCH-STATUS.md). Ignored so it cannot happen again.
/step 1 피드백/
/디자인 영상 프레임 분석.zip
